# Copy to .env. Nothing here is a secret yet; later phases add some, and say so.

# Where the server listens. docker-compose sets HOST=0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=8080
# The names clients may use to reach the server (the Host header), comma-separated.
# Requests for any other name are refused (protection against DNS rebinding).
ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
LOG_LEVEL=INFO
