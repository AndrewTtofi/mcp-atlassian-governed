# Copy to .env. It is gitignored; never commit it.

# Where the server listens. docker-compose sets HOST=0.0.0.0 inside the container.
HOST=127.0.0.1
PORT=8080
# The names clients may use to reach the server (the Host header), comma-separated.
# Requests for any other name are refused (protection against DNS rebinding).
ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
LOG_LEVEL=INFO

# Identity. The server accepts access tokens your identity provider issued for it.
# OIDC_ISSUER is exactly the tokens' `iss`; OIDC_AUDIENCE must be in their `aud`.
# OIDC_JWKS_URL is optional (default: from the issuer's discovery document).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# This server's own address as clients know it (its OAuth resource identifier).
RESOURCE_URL=http://localhost:8080/mcp
# The scope every call needs.
READ_SCOPE=atlassian:read
# Tools that change things. A call to one also needs WRITE_SCOPE. WRITE_TOOLS is the
# allow-list, comma-separated: jira_add_comment, jira_create_issue, jira_delete_comment.
# A tool not listed does not exist as far as clients can tell. Empty: read-only.
# With any of them enabled, add `write:jira-work` to ATLASSIAN_SCOPES and to the app.
WRITE_SCOPE=atlassian:write
WRITE_TOOLS=
# With no identity provider configured the server refuses to start, unless this is true:
# then anyone who can reach the port can call it. Local development only.
ALLOW_ANONYMOUS=false

# Where a browser signs in and where this server redeems the code. Default: from the
# issuer's discovery document. Set them when users and this server reach the identity
# provider at different addresses.
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
# This server's address as a user's browser reaches it. The Atlassian app's callback URL
# is PUBLIC_URL + /atlassian/callback.
PUBLIC_URL=http://localhost:8080

# Atlassian: the OAuth 2.0 (3LO) app each user grants access to (README: "Connect
# Atlassian"). Both empty: the Jira and Confluence tools are not offered.
ATLASSIAN_CLIENT_ID=
# SECRET.
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_SCOPES=read:jira-work read:jira-user read:confluence-content.all search:confluence read:me offline_access
# SECRET. Encrypts users' Atlassian tokens in the database. Generate: python -m app.store
# Comma-separated to rotate: the first key encrypts, all of them decrypt.
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/mcp.sqlite3

# Only for `make idp` (docker-compose.idp.yml: authentik as the identity provider).
# Secrets: generate each with `openssl rand -hex 32`. docker-compose.idp.yml sets the
# OIDC_* variables for the server itself.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
